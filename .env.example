# Runtime environment mode (development, staging, production)
ENVIRONMENT=development

# Enable or disable debug mode
DEBUG=true

# Database connection string (PostgreSQL for production, SQLite for local testing)
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/smart_gst_db

# Cryptographic secret key for signing JWT authentication tokens
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production

# JWT signature algorithm
JWT_ALGORITHM=HS256

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Google Gemini API key for Explainable AI rationale synthesis
GEMINI_API_KEY=

# Confidence score threshold percentage for classification approval
CONFIDENCE_THRESHOLD=80.0

# Optional licensed GST Suvidha Provider (GSP) API authentication key
GST_PROVIDER_API_KEY=

# GSP endpoint for taxpayer verification lookups
GST_PROVIDER_URL=https://api.gst.gov.in/taxpayer

# Display name of the configured GSP provider
GST_PROVIDER_NAME=Licensed GSP Service

# Timeout in seconds for GSP network requests
GST_PROVIDER_TIMEOUT_SEC=5

# Duration in hours to cache verified GSTIN profiles locally
GST_CACHE_TTL_HOURS=24

# Toggle Neo4j graph database integration for multi-hop taxonomy queries
ENABLE_NEO4J=false

# Neo4j Bolt protocol URI
NEO4J_URI=bolt://localhost:7687

# Neo4j database username
NEO4J_USER=neo4j

# Neo4j database password
NEO4J_PASSWORD=your_neo4j_password_here

# Frontend Vite API proxy target URL
VITE_API_URL=http://localhost:8000
